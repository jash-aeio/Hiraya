# Hiraya environment template. Copy to .env.local and fill in.
# Never commit a filled-in copy: .env and .env.* are gitignored for a reason.
#
# CONTRIBUTORS (D26): you do not need a Supabase account and will not be given
# the project's keys. Local work needs only DATABASE_URL, TEST_DATABASE_URL
# (a DIFFERENT database - the suite disables RLS mid-test), LRN_HMAC_PEPPER and
# HIRAYA_DEMO_SCHOOLS. Leave the NEXT_PUBLIC_SUPABASE_* and SUPABASE_SERVICE_ROLE_KEY
# values as placeholders: modules read them at import, and nothing they name is
# reachable with the Data API disabled. See CONTRIBUTING.md section 2.

# --- Supabase project ------------------------------------------------------
# The project's Data API (PostgREST) is DISABLED (D22): /api/v1 is the single
# data layer. These two keys are for Supabase Auth only - the anon key signs the
# browser in, and no supabase-js `.from()` call will reach anything.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role bypasses RLS entirely. Server environment only; it is read by
# exactly one module, src/lib/db/admin.ts (CLAUDE.md R2), and only for the
# GoTrue admin API - table writes go through withServiceRole() over Drizzle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (Drizzle migrations and server queries) ----------------------
# Owner connection. Used for migrations and by the request-scoped RLS client,
# which drops to the `authenticated` role for the duration of each transaction.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Pool sizes. The admin pool is the RLS-bypassing owner path; keep it small.
# DATABASE_POOL_MAX=10
# DATABASE_ADMIN_POOL_MAX=2

# Separate URL used by the integration suite. Pointing this at a database that
# holds real learner data would be a Gate B violation; it must be a throwaway.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Secrets that must never reach a client bundle -------------------------
# HMAC pepper for LRN de-duplication at import (DATA_FLOW.md §4).
LRN_HMAC_PEPPER=change-me-32-bytes-minimum

# Ed25519 private key for learner ID tokens. Server environment only.
# NEVER ship this in a Capacitor bundle: a native binary is trivially unpacked.
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_PUBLIC_KEY=

# Which demo tenants THIS deployment may serve, by school slug, comma-separated.
# The second half of the D23 gate: a persona is offered only if its school is
# flagged is_demo in the database AND named here. Unset means no demo at all,
# which is the safe default -- the variable exists to stop an unauthenticated
# endpoint ever listing a real school's learners.
HIRAYA_DEMO_SCHOOLS=halimbawa-demo

# --- Lane P, while the endpoints are being written ------------------------
# `on` makes the screens whose /api/v1 route has not merged yet render from a
# local fixture instead of failing (src/lib/fixtures.ts). Unset - the default,
# and what CI and every deployment use - means those screens show their failure
# state, which is the truth until Lane D's half lands. Deleted with D-01..D-04.
# NEXT_PUBLIC_HIRAYA_FIXTURES=on
